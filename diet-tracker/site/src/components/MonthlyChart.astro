---
// 月別の発言数（衆議院・参議院の積み上げ縦棒）。会議録の公開待ちで少なく出る直近の月は斜線で示す。
import type { MonthBucket } from "../lib/data";

interface Props {
  buckets: MonthBucket[];
  pendingFrom: string; // この月（YYYY-MM）以降は公開待ちの可能性あり
  caption: string;
  height?: number;
}
const { buckets, pendingFrom, caption, height = 220 } = Astro.props;

const rawMax = Math.max(1, ...buckets.map((b) => b.total));
const steps = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000];
const step = steps.find((s) => rawMax / s <= 5) ?? Math.ceil(rawMax / 5);
const max = Math.ceil(rawMax / step) * step;
const ticks: number[] = [];
for (let v = 0; v <= max; v += step) ticks.push(v);
const label = (m: string) => {
  const [y, mm] = m.split("-").map(Number);
  return `${y}年${mm}月`;
};
const hasOther = buckets.some((b) => b.other > 0);
---

<p class="legend">
  <span class="key"><span class="swatch" aria-hidden="true"></span>衆議院</span>
  <span class="key"><span class="swatch s2" aria-hidden="true"></span>参議院</span>
  <span class="key"><span class="swatch pending" aria-hidden="true"></span>会議録の公開待ちで少なめの可能性</span>
</p>
<div class="mcols chart" role="group" aria-label={caption} style={`--h:${height}px`}>
  <div class="mcols-plot">
    <div class="mcols-grid" aria-hidden="true">
      {
        ticks.map((t) => (
          <div class={t === 0 ? "tick base" : "tick"} style={`bottom:${(t / max) * 100}%`}>
            <span>{t.toLocaleString("ja-JP")}</span>
          </div>
        ))
      }
    </div>
    <div class="mcols-bars">
      {
        buckets.map((b) => {
          const pending = b.month >= pendingFrom;
          const tip = `${label(b.month)}：衆議院 ${b.shu}件・参議院 ${b.san}件${b.other ? `・両院 ${b.other}件` : ""}${pending ? "（公開待ちで少なめの可能性）" : ""}`;
          return (
            <div
              class={`mcol${pending ? " pending" : ""}`}
              tabindex="0"
              data-tip-value={`${b.total.toLocaleString("ja-JP")}件`}
              data-tip-label={tip}
              aria-label={tip}
            >
              <span class="stack" style={`height:${(b.total / max) * 100}%`}>
                {b.san + b.other > 0 && <span class="seg s2" style={`flex:${b.san + b.other}`} />}
                {b.shu > 0 && <span class="seg s1" style={`flex:${b.shu}`} />}
              </span>
            </div>
          );
        })
      }
    </div>
  </div>
  <div class="mcols-x" aria-hidden="true">
    {
      buckets.map((b) => {
        const [y, m] = b.month.split("-").map(Number);
        return <span>{m === 1 ? `${y}` : m === 7 ? "7月" : ""}</span>;
      })
    }
  </div>
</div>
<details class="table-view">
  <summary>表で見る</summary>
  <table class="data-table">
    <caption class="small muted" style="text-align:left">{caption}</caption>
    <thead>
      <tr><th>月</th><th class="num">衆議院</th><th class="num">参議院</th>{hasOther && <th class="num">両院</th>}<th class="num">合計</th></tr>
    </thead>
    <tbody>
      {
        [...buckets].reverse().map((b) => (
          <tr>
            <td>{label(b.month)}{b.month >= pendingFrom ? "＊" : ""}</td>
            <td class="num">{b.shu}</td>
            <td class="num">{b.san}</td>
            {hasOther && <td class="num">{b.other}</td>}
            <td class="num">{b.total}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="small muted">＊会議録の公開待ちで、実際より少ない可能性があります。</p>
</details>

<style>
  .mcols {
    --axis-w: 40px;
  }
  .mcols-plot {
    position: relative;
    height: var(--h);
    margin-left: var(--axis-w);
    margin-top: 8px;
  }
  .mcols-grid .tick {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px solid var(--grid);
  }
  .mcols-grid .tick.base {
    border-top-color: var(--baseline);
  }
  .mcols-grid .tick span {
    position: absolute;
    right: calc(100% + 8px);
    transform: translateY(-50%);
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .mcols-bars {
    position: absolute;
    inset: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 2px;
  }
  .mcol {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
    border-radius: 4px 4px 0 0;
    cursor: default;
  }
  .mcol:hover,
  .mcol:focus-visible {
    background: var(--surface-2);
  }
  .stack {
    display: flex;
    flex-direction: column;
    width: min(24px, 80%);
    gap: 2px;
  }
  .seg {
    display: block;
    min-height: 1px;
  }
  .seg:first-child {
    border-radius: 4px 4px 0 0;
  }
  .seg.s1 {
    background: var(--series-1);
  }
  .seg.s2 {
    background: var(--series-2);
  }
  .mcol.pending .seg.s1 {
    background: repeating-linear-gradient(135deg, var(--series-1) 0 2px, transparent 2px 5px);
    box-shadow: inset 0 0 0 1px var(--series-1);
  }
  .mcol.pending .seg.s2 {
    background: repeating-linear-gradient(135deg, var(--series-2) 0 2px, transparent 2px 5px);
    box-shadow: inset 0 0 0 1px var(--series-2);
  }
  .mcol:hover .seg.s1,
  .mcol:focus-visible .seg.s1 {
    background: var(--series-1-hover);
  }
  .mcol:hover .seg.s2,
  .mcol:focus-visible .seg.s2 {
    background: var(--series-2-hover);
  }
  .mcols-x {
    margin-left: var(--axis-w);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 2px;
    margin-top: 6px;
  }
  .mcols-x span {
    display: flex;
    justify-content: flex-start;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: visible;
    font-variant-numeric: tabular-nums;
  }
</style>
