---
// 発言1件の抜粋。全文は会議録へのリンクで読んでもらう
import { formatJpDate, speechUrl, type Row } from "../lib/data";
import { CHAIR, isGovernmentPosition, speakerClass } from "../lib/groups";

interface Props {
  row: Row;
  snippet: string;
}
const { row: r, snippet } = Astro.props;
const HOUSE_NAME: Record<string, string> = { 衆: "衆議院", 参: "参議院", 両: "両院" };
// 議長・委員長は「議長・委員長」、大臣や政府職員・参考人などは肩書き、議員は会派を添える
const role = r[7]
  ? CHAIR
  : isGovernmentPosition(r[6]) || (!r[5] && r[6])
    ? r[6]
    : speakerClass(r[5], r[6], r[7]);
---

<li class="card speech">
  <p class="head">
    <span><b>{formatJpDate(r[1])}</b></span>
    <span>{HOUSE_NAME[r[2]] ?? r[2]} {r[3]}</span>
    <span>{r[4]}（{role}）</span>
  </p>
  <blockquote>{snippet}</blockquote>
  <a class="src" href={speechUrl(r[0])} rel="noopener">会議録で全文を読む</a>
</li>
